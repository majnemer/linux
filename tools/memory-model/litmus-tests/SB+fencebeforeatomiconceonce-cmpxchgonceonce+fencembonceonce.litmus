C SB+fencebeforeatomiconceonce-cmpxchgonceonce+fencembonceonce

(*
 * Result: Never
 *
 * This litmus test demonstrates that a full memory barrier constructed from
 * smp_mb__before_atomic() and a relaxed, potentially failing,
 * read-modify-write operation suffices to order the store-buffering pattern,
 * where each process writes to the variable that the preceding process reads.
 *)

{}

P0(int *x, int *y)
{
  int r0;

  WRITE_ONCE(*x, 1);
  smp_mb();
  r0 = READ_ONCE(*y);
}

P1(int *x, int *y)
{
  int r0;

  WRITE_ONCE(*y, 1);
  smp_mb__before_atomic();
  r0 = cmpxchg_relaxed(x, 1, 0);
}

exists (0:r0=0 /\ 1:r0=0)
